,"display_text":null,"raw_input":"[{\"Key\":\"MIN\",\"Value\":\"5\"},{\"Key\":\"MAX\",\"Value\":\"15\"}]","comment":"Random video will view"},{"$type":"GPMAutomateEditor.Models.ForBlockNode, GPMAutomateEditor.Models","nodes":[{"$type":"GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models","type":11,"element_xpath":null,"output_variable_name":"random_scroll","delay":"0,0","use_failed_block":false,"failed_block":null,"failed_block_expanded":false,"id":"7360faf1-8d7f-49d4-9b2b-7b72ff26ebec","display_text":null,"raw_input":"[{\"Key\":\"MIN\",\"Value\":\"8\"},{\"Key\":\"MAX\",\"Value\":\"20\"}]","comment":"Random scroll"},{"$type":"GPMAutomateEditor.Models.ForBlockNode, GPMAutomateEditor.Models","nodes":[{"$type":"GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models","type":54,"element_xpath":null,"output_variable_name":null,"delay":"300,900","use_failed_block":false,"failed_block":null,"failed_block_expanded":false,"id":"9eeee19a-d98b-4e67-a682-fb8af22108ac","display_text":null,"raw_input":"[{\"Key\":\"TYPE\",\"Value\":\"SINGLE_KEY\"},{\"Key\":\"KEY\",\"Value\":\"Space\"},{\"Key\":\"DELAY_PRESS\",\"Value\":\"\"}]","comment":"Scroll"}],"expanded":true,"id":"abc602dc-937c-4191-b71c-ab17731c7037","display_text":null,"raw_input":"[{\"Key\":\"START\",\"Value\":\"1\"},{\"Key\":\"END\",\"Value\":\"$random_scroll\"},{\"Key\":\"INCREASE_BY\",\"Value\":\"1\"}]","comment":null},{"$type":"GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models","type":11,"element_xpath":null,"output_variable_name":"video_picked","delay":"0,0","use_failed_block":false,"failed_block":null,"failed_block_expanded":false,"id":"87723b60-eae6-4f35-9f24-aaf566455300","display_text":null,"raw_input":"[{\"Key\":\"MIN\",\"Value\":\"1\"},{\"Key\":\"MAX\",\"Value\":\"3\"}]","comment":"Random pick video"},{"$type":"GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models","nodes":[{"$type":"GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models","type":48,"element_xpath":null,"output_variable_name":null,"delay":"1000,3000","use_failed_block":false,"failed_block":null,"failed_block_expanded":false,"id":"7509f5b3-6058-45e8-824b-ad34a013ba20","display_text":null,"raw_input":"[{\"Key\":\"CLICK_TYPE\",\"Value\":\"CLICK_XPATH\"},{\"Key\":\"XPATH\",\"Value\":\"//*[@data-e2e='comment-icon']\"},{\"Key\":\"POS\",\"Value\":\"\"}]","comment":"Click comment button"},{"$type":"GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models","type":68,"element_xpath":null,"output_variable_name":"has_bridge_link","delay":"0,0","use_failed_block":false,"failed_block":null,"failed_block_expanded":false,"id":"78657328-f67e-4662-939f-7399cb71b0b5","display_text":null,"raw_input":"[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"let last = location.href;\\r\\nlet isHasLink = false;\\r\\n\\r\\nsetInterval(() => {\\r\\n  if (location.href !== last) {\\r\\n    last = location.href;\\r\\n    if (/onelink\\\\.me|snssdk/i.test(last)) {\\r\\n      isHasLink = true;\\r\\n    } else {\\r\\n      isHasLink = false;\\r\\n    }\\r\\n  }\\r\\n}, 300);\\r\\n\\r\\nreturn isHasLink ;\\r\\n\"}]","comment":null},{"$type":"GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models","nodes":[{"$type":"GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models","type":40,"element_xpath":null,"output_variable_name":null,"delay":"0,0","use_failed_block":false,"failed_block":null,"failed_block_expanded":false,"id":"bb4d0ab8-474c-44fb-b076-ac5122dab994","display_text":null,"raw_input":"[]","comment":null}],"expanded":true,"id":"278e040d-ba0e-490f-9eeb-888fedf30a7f","display_text":null,"raw_input":"[{\"Key\":\"CONDITION\",\"Value\":\"$has_bridge_link=true\"}]","comment":""},{"$type":"GPMAutomateEditor.Models.ElseBlockNode, GPMAutomateEditor.Models","nodes":[{"$type":"GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models","type":68,"element_xpath":null,"output_variable_name":"is_click_exit_comment","delay":"0,0","use_failed_block":false,"failed_block":null,"failed_block_expanded":false,"id":"69cde50f-fbd1-46cf-a92a-c2648de74bb8","display_text":null,"raw_input":"[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"const el = document.querySelector(\\\"[aria-label='exit']\\\");\\r\\nif (el) el.click();\"}]","comment":null}],"expanded":true,"id":"5f2ba270-373b-409a-a39b-077ac6aec7ac","display_text":null,"raw_input":"[]","comment":null}],"expanded":true,"id":"b0d782b1-adcd-4963-9abb-f9749e2c7d4d","display_text":null,"raw_input":"[{\"Key\":\"CONDITION\",\"Value\":\"$video_picked=2\"}]","comment":"Video is picked"},{"$type":"GPMAutomateEditor.Models.ForBlockNode, GPMAutomateEditor.Models","nodes":[{"$type":"GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models","type":54,"element_xpath":null,"output_variable_name":null,"delay":"0,0","use_failed_block":false,"failed_block":null,"failed_block_expanded":false,"id":"be9b4141-4af8-40a9-85ef-861c5ab7b373","display_text":null,"raw_input":"[{\"Key\":\"TYPE\",\"Value\":\"SINGLE_KEY\"},{\"Key\":\"KEY\",\"Value\":\"Space\"},{\"Key\":\"DELAY_PRESS\",\"Value\":\"\"}]","comment":null}],"expanded":false,"id":"232682e6-80a0-46e7-a0f7-45d0fc439d7f","display_text":null,"raw_input":"[{\"Key\":\"START\",\"Value\":\"1\"},{\"Key\":\"END\",\"Value\":\"$random_scroll\"},{\"Key\":\"INCREASE_BY\",\"Value\":\"1\"}]","comment":null},{"$type":"GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models","type":68,"element_xpath":null,"output_variable_name":"is_clicked_avatar","delay":"1000,3000","use_failed_block":false,"failed_block":null,"failed_block_expanded":false,"id":"efb2b566-81a5-460c-b3ff-63da62822dbc","display_text":null,"raw_input":"[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"const el = document.querySelector('a[data-e2e=\\\"video-author-avatar\\\"]');\\r\\n\\r\\nif (el) {\\r\\n  el.click();\\r\\n}\\r\\n\"}]","comment":null},{"$type":"GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models","type":68,"element_xpath":null,"output_variable_name":"close_share_profile_modal","delay":"0,0","use_failed_block":false,"failed_block":null,"failed_block_expanded":false,"id":"a534562a-4482-49e0-a4db-e1522473b7c2","display_text":null,"raw_input":"[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"const el = document.querySelector(\\\"[aria-label='close']\\\");\\r\\nif (el) el.click();\"}]","comment":null},{"$type":"GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models","type":54,"element_xpath":null,"output_variable_name":null,"delay":"0,0","use_failed_block":false,"failed_block":null,"failed_block_expanded":false,"id":"23418010-d8bd-4eed-9147-881bf046d43e","display_text":null,"raw_input":"[{\"Key\":\"TYPE\",\"Value\":\"SINGLE_KEY\"},{\"Key\":\"KEY\",\"Value\":\"Space\"},{\"Key\":\"DELAY_PRESS\",\"Value\":\"\"}]","comment":null},{"$type":"GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models","type":68,"element_xpath":null,"output_variable_name":"random_interact_in_profile","delay":"0,0","use_failed_block":false,"failed_block":null,"failed_block_expanded":false,"id":"94f659cb-b660-4141-9568-c7dae847bbb1","display_text":null,"raw_input":"[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"const SCROLL_TIMES = 5;\\r\\nconst SCROLL_DELAY = [1000, 3000];\\r\\nconst WATCH_TIME = [5000, 15000];\\r\\nconst AFTER_WATCH_DELAY = [3000, 6000];\\r\\n\\r\\nconst sleep = ms => new Promise(r => setTimeout(r, ms));\\r\\nconst rand = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;\\r\\n\\r\\nconst scrollProfile = async () => {\\r\\n  for (let i = 0; i < SCROLL_TIMES; i++) {\\r\\n    window.scrollBy(0, window.innerHeight);\\r\\n    await sleep(rand(...SCROLL_DELAY));\\r\\n  }\\r\\n};\\r\\n\\r\\nconst getRandomVideo = () => {\\r\\n  let videos = [...document.querySelectorAll('a[href*=\\\"/video/\\\"]')];\\r\\n\\r\\n  if (videos.length > 3) videos = videos.slice(2);\\r\\n\\r\\n  if (!videos.length) return null;\\r\\n\\r\\n  return videos[Math.floor(Math.random() * videos.length)];\\r\\n};\\r\\n\\r\\nconst hover = el => {\\r\\n  el.dispatchEvent(new MouseEvent(\\\"mouseover\\\", { bubbles: true }));\\r\\n};\\r\\n\\r\\nconst run = async () => {\\r\\n\\r\\n  await scrollProfile();\\r\\n\\r\\n  const video = getRandomVideo();\\r\\n  if (!video) return console.log(\\\"❌ No video found\\\");\\r\\n\\r\\n  video.scrollIntoView({ behavior: \\\"smooth\\\", block: \\\"center\\\" });\\r\\n  await sleep(rand(600, 1200));\\r\\n\\r\\n  hover(video);\\r\\n  await sleep(rand(300, 700));\\r\\n\\r\\n  video.click();\\r\\n\\r\\n  await sleep(rand(...WATCH_TIME));\\r\\n\\r\\n  document.body.dispatchEvent(new MouseEvent(\\\"mousemove\\\", { bubbles: true }));\\r\\n  await sleep(rand(...AFTER_WATCH_DELAY));\\r\\n\\r\\n  window.history.back();\\r\\n};\\r\\n\\r\\nrun();\\r\\n\"}]","comment":null}],"expanded":true,"id":"700449bf-85f3-43b0-8f61-d6021a1b58fa","display_text":null,"raw_input":"[{\"Key\":\"START\",\"Value\":\"1\"},{\"Key\":\"END\",\"Value\":\"$will_view_amount\"},{\"Key\":\"INCREASE_BY\",\"Value\":\"1\"}]","comment":null}],"expanded":true,"id":"5e8a1389-9f07-4f64-a0d9-23c1b3ee4183","display_text":null,"raw_input":null,"comment":"Main logic"},"after_quit":{"$type":"GPMAutomateEditor.Models.NormalBlockNode, GPMAutomateEditor.Models","nodes":[],"expanded":false,"id":"b6b7c4fb-0458-413d-a0de-dccd134d098e","display_text":null,"raw_input":null,"comment":"After browser closed"}}